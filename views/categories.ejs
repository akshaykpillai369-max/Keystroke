<%- include('partials/head', { title: 'Smart Categories' }) %>
<%- include('partials/sidebar') %>

<!-- Top Nav Bar -->
<header class="fixed top-0 right-0 w-[calc(100%-16rem)] flex justify-between items-center px-margin-desktop py-4 z-40 backdrop-blur-xl bg-surface-dim/30">
  <div class="flex items-center gap-6 flex-1">
    <div class="relative w-full max-w-md">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">search</span>
      <input class="w-full bg-surface-container-low border-none focus:ring-1 focus:ring-primary rounded-full py-2 pl-10 text-body-sm text-on-surface placeholder:text-on-surface-variant/50" placeholder="Search tasks or insights..." type="text" />
    </div>
  </div>
  <div class="flex items-center gap-6">
    <div class="flex items-center gap-4">
      <span class="material-symbols-outlined text-on-surface-variant hover:text-primary cursor-pointer transition-colors">notifications</span>
      <span class="material-symbols-outlined text-on-surface-variant hover:text-secondary cursor-pointer transition-colors">spark</span>
    </div>
    <button class="bg-secondary-container text-on-secondary-container px-6 py-2 rounded-full font-label-md hover:opacity-80 active:scale-95 transition-all flex items-center gap-2" onclick="toggleDrawer()">
      <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
      AI Assistant
    </button>
    <div class="w-10 h-10 rounded-full bg-secondary-container border-2 border-outline-variant/30 flex items-center justify-center text-on-secondary-container font-semibold text-sm">A</div>
  </div>
</header>

<!-- Main Content -->
<main class="ml-64 pt-24 px-margin-desktop pb-12 max-w-container-max mx-auto">
  <div class="mb-12">
    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Smart Categories</h2>
    <p class="text-on-surface-variant max-w-xl">AI-curated prioritization based on your energy patterns and upcoming deadlines.</p>
  </div>

  <!-- Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-12">
    <% const catColors = {
      'Work': { icon: 'psychology', badge: 'High Focus', bg: 'primary', color: 'primary' },
      'Personal': { icon: 'favorite', badge: 'Balance', bg: 'error', color: 'error' },
      'Side Project': { icon: 'bolt', badge: 'Creative', bg: 'secondary', color: 'secondary' },
      'Health': { icon: 'self_improvement', badge: 'Wellness', bg: 'tertiary', color: 'tertiary' },
      'Uncategorized': { icon: 'category', badge: 'Other', bg: 'outline', color: 'on-surface-variant' }
    }; %>
    <% categoryNames.forEach((cat, idx) => { %>
    <% const tasks = categories[cat] || []; %>
    <% const cc = catColors[cat] || catColors['Uncategorized']; %>
    <div class="glass-card <%= cat === 'Work' ? 'ai-glow' : '' %> p-6 rounded-3xl flex flex-col h-full" style="animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) <%= idx * 0.1 %>s both;">
      <div class="flex justify-between items-start mb-6">
        <div class="w-12 h-12 bg-<%= cc.bg %>/10 rounded-2xl flex items-center justify-center text-<%= cc.color %>">
          <span class="material-symbols-outlined text-3xl"><%= cc.icon %></span>
        </div>
        <span class="bg-<%= cc.color %>/20 text-<%= cc.color %> font-label-caps px-3 py-1 rounded-full"><%= cc.badge %></span>
      </div>
      <h3 class="font-headline-lg text-2xl text-on-surface mb-2"><%= cat %></h3>
      <div class="flex items-center gap-2 mb-4">
        <span class="text-<%= cc.color %> font-bold text-lg"><%= tasks.length %></span>
        <span class="text-on-surface-variant font-label-md">tasks pending</span>
      </div>
      <div class="space-y-2 flex-1">
        <% tasks.slice(0, 3).forEach(t => { %>
        <div class="p-2.5 rounded-xl bg-surface-variant/30">
          <p class="text-sm font-medium text-on-surface"><%= t.title %></p>
          <div class="flex items-center gap-2 mt-1">
            <span class="font-label-caps text-[10px] <%= t.status === 'Completed' ? 'text-green-400' : t.status === 'In Progress' ? 'text-primary' : 'text-on-surface-variant' %>"><%= t.status %></span>
            <span class="font-label-caps text-[10px] text-on-surface-variant"><%= Math.floor(t.durationLogged / 60) %>m</span>
          </div>
        </div>
        <% }) %>
        <% if (tasks.length === 0) { %>
        <p class="text-on-surface-variant text-sm text-center py-4">No tasks</p>
        <% } %>
      </div>
      <div class="mt-auto pt-4 border-t border-outline-variant/10">
        <div class="flex gap-2 items-start text-on-surface-variant">
          <span class="material-symbols-outlined text-secondary text-sm">spark</span>
          <p class="text-body-sm italic"><%= ['"Best done before 11 AM when your cognitive load is lowest."', '"Momentum builder: Finish these between meetings."', '"Batch these for your 4 PM transition period."', '"Schedule these for post-6 PM to recharge."', '"Organize these to keep your workspace clean."'][idx % 5] %></p>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Detailed View -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
    <div class="lg:col-span-2 space-y-6">
      <div class="flex justify-between items-end mb-4">
        <h4 class="font-headline-lg text-xl text-on-surface">Prioritized for Now</h4>
        <button class="text-primary font-label-md hover:underline">View All</button>
      </div>
      <% const allTasks = Object.values(categories).flat().filter(t => t.status !== 'Completed').slice(0, 5); %>
      <% allTasks.forEach(t => { %>
      <div class="glass-card p-4 rounded-2xl flex items-center gap-4 group">
        <button class="w-6 h-6 rounded-full border-2 border-outline-variant group-hover:border-primary transition-colors cursor-pointer flex items-center justify-center flex-shrink-0" onclick="updateTaskStatus('<%= t._id %>', 'Completed')">
          <div class="w-2 h-2 bg-primary rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </button>
        <div class="flex-1 min-w-0">
          <h5 class="text-on-surface font-medium truncate"><%= t.title %></h5>
          <div class="flex items-center gap-3 mt-1">
            <span class="text-label-caps font-label-caps text-primary bg-primary/10 px-2 py-0.5 rounded"><%= t.category %></span>
            <span class="text-label-caps font-label-caps text-on-surface-variant flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">schedule</span>
              <%= Math.floor(t.durationLogged / 60) || '0' %>m
            </span>
          </div>
        </div>
        <span class="material-symbols-outlined text-on-surface-variant">more_vert</span>
      </div>
      <% }) %>
      <% if (allTasks.length === 0) { %>
      <p class="text-on-surface-variant text-center py-8">No active tasks across categories.</p>
      <% } %>
    </div>

    <!-- AI Insights Panel -->
    <div class="space-y-6">
      <div class="glass-card p-8 rounded-[2rem] bg-gradient-to-br from-surface-container-high to-surface-dim border-primary/20 relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 blur-3xl rounded-full"></div>
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">spark</span>
            <h4 class="font-headline-lg text-lg text-on-surface">Energy Forecast</h4>
          </div>
          <div class="space-y-6">
            <div>
              <div class="flex justify-between font-label-md mb-2">
                <span class="text-on-surface-variant">Peak Cognitive State</span>
                <span class="text-primary">85%</span>
              </div>
              <div class="w-full h-1 bg-outline-variant/30 rounded-full overflow-hidden">
                <div class="h-full bg-primary w-[85%]"></div>
              </div>
            </div>
            <div class="p-4 bg-surface-container-lowest/50 rounded-2xl border border-outline-variant/10">
              <p class="text-body-sm text-on-surface-variant leading-relaxed">
                Your focus historically peaks between <span class="text-on-surface font-semibold">9:00 AM and 11:30 AM</span>. We've prioritized your most demanding tasks in this window.
              </p>
            </div>
            <button class="w-full py-3 bg-surface-variant/50 hover:bg-surface-variant text-on-surface font-label-md rounded-xl border border-outline-variant/20 active:scale-[0.98] transition-all">Optimize My Schedule</button>
          </div>
        </div>
      </div>

      <!-- Weekly Velocity -->
      <div class="glass-card p-6 rounded-3xl">
        <div class="flex items-center justify-between mb-4">
          <span class="font-label-caps text-on-surface-variant">Weekly Velocity</span>
          <span class="text-primary text-sm flex items-center gap-1"><span class="material-symbols-outlined text-sm">trending_up</span> +12%</span>
        </div>
        <div class="flex items-end gap-2 h-20 px-2">
          <div class="w-full bg-primary/20 h-[40%] rounded-t-sm"></div>
          <div class="w-full bg-primary/20 h-[60%] rounded-t-sm"></div>
          <div class="w-full bg-primary/20 h-[45%] rounded-t-sm"></div>
          <div class="w-full bg-primary/20 h-[80%] rounded-t-sm"></div>
          <div class="w-full bg-primary h-[95%] rounded-t-sm"></div>
          <div class="w-full bg-primary/40 h-[70%] rounded-t-sm"></div>
          <div class="w-full bg-primary/20 h-[30%] rounded-t-sm"></div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- AI Drawer -->
<div class="fixed right-0 top-0 h-screen w-80 bg-surface-container-low/90 backdrop-blur-2xl border-l border-outline-variant/20 shadow-2xl shadow-primary/10 z-50 translate-x-full transition-transform duration-500 ease-in-out" id="ai-drawer">
  <div class="flex flex-col p-gutter h-full">
    <div class="flex justify-between items-start mb-8">
      <div>
        <h3 class="font-headline-lg text-headline-lg text-secondary">AI Assistant</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant">How can I help you focus?</p>
      </div>
      <button class="p-2 hover:bg-surface-variant rounded-full text-on-surface-variant" onclick="toggleDrawer()"><span class="material-symbols-outlined">close</span></button>
    </div>
    <nav class="space-y-4">
      <div class="flex items-center gap-4 p-4 bg-secondary-container text-on-secondary-container rounded-xl cursor-pointer">
        <span class="material-symbols-outlined">account_tree</span>
        <span class="font-label-caps text-label-caps">Task Breakdown</span>
      </div>
      <div class="flex items-center gap-4 p-4 text-on-surface-variant hover:bg-surface-variant/30 rounded-xl cursor-pointer transition-all">
        <span class="material-symbols-outlined">schedule</span>
        <span class="font-label-caps text-label-caps">Suggested Times</span>
      </div>
    </nav>
    <div class="mt-auto p-4 glass-card rounded-2xl">
      <p class="text-body-sm text-on-surface-variant mb-4">"You have a 2-hour gap in your calendar. Should I schedule your 'Deep Work' session now?"</p>
      <div class="flex gap-2">
        <button class="flex-1 py-2 bg-secondary text-on-secondary font-label-md rounded-lg">Yes, please</button>
        <button class="flex-1 py-2 border border-outline-variant text-on-surface font-label-md rounded-lg">Maybe later</button>
      </div>
    </div>
  </div>
</div>

<button class="fixed bottom-8 right-8 w-16 h-16 bg-gradient-to-br from-primary to-secondary rounded-full shadow-lg shadow-primary/30 flex items-center justify-center text-on-primary hover:scale-110 active:scale-95 transition-all z-40" onclick="toggleDrawer()">
  <span class="material-symbols-outlined text-3xl">smart_toy</span>
</button>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/main.js"></script>
<script>
function toggleDrawer() { document.getElementById('ai-drawer').classList.toggle('translate-x-full'); }
function updateTaskStatus(id, status) {
  fetch('/api/tasks/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) })
    .then(() => window.location.reload());
}
// Intersection observer for fade-in
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => { if (entry.isIntersecting) { entry.target.style.opacity = '1'; entry.target.style.transform = 'translateY(0)'; } });
}, { threshold: 0.1 });
document.querySelectorAll('.glass-card').forEach(card => {
  card.style.opacity = '0';
  card.style.transform = 'translateY(20px)';
  card.style.transition = 'all 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
  observer.observe(card);
});
</script>
</body>
</html>
