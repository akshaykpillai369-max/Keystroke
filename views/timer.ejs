<%- include('partials/head', { title: 'Focus Timer' }) %>
<%- include('partials/sidebar') %>

<!-- Main Content -->
<main class="ml-64 flex flex-row min-h-screen relative z-10">
  <!-- Timer Core -->
  <section class="flex-1 flex flex-col items-center justify-center px-margin-desktop gap-12">
    <div class="relative flex flex-col items-center">
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/10 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-secondary/10 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="relative z-10 text-center">
        <span class="font-label-caps text-label-caps text-secondary tracking-[0.2em] mb-4 block uppercase" id="phaseLabel">Deep Focus Phase</span>
        <div class="font-display-lg text-[120px] md:text-[160px] leading-none font-bold text-on-surface timer-glow tracking-tighter" id="timer-display">25:00</div>
        <div class="flex items-center justify-center gap-6 mt-12">
          <button class="w-16 h-16 rounded-full glass-card flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-95" id="btnReset">
            <span class="material-symbols-outlined text-3xl">refresh</span>
          </button>
          <button class="w-24 h-24 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-2xl shadow-primary/40 hover:scale-105 active:scale-95 transition-all" id="play-pause">
            <span class="material-symbols-outlined text-5xl" id="playIcon" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
          </button>
          <button class="w-16 h-16 rounded-full glass-card flex items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-95" id="btnSkip">
            <span class="material-symbols-outlined text-3xl">skip_next</span>
          </button>
        </div>
        <!-- Mode Toggle -->
        <div class="mt-8 flex items-center justify-center gap-4">
          <button class="px-4 py-2 rounded-full font-label-md timer-mode-btn active bg-primary/20 text-primary active:scale-95 transition-all" data-mode="pomodoro">Pomodoro</button>
          <button class="px-4 py-2 rounded-full font-label-md timer-mode-btn text-on-surface-variant hover:text-on-surface active:scale-95 transition-all" data-mode="stopwatch">Stopwatch</button>
        </div>
        <!-- Pomodoro Config -->
        <div class="mt-4 flex items-center justify-center gap-4 text-sm" id="pomodoroConfig">
          <div>
            <label class="text-on-surface-variant font-label-md">Focus</label>
            <select id="pomodoroFocus" class="ml-2 px-3 py-1.5 rounded-lg bg-surface-container-low text-on-surface border border-outline-variant/30 outline-none font-label-md">
              <option value="25">25 min</option>
              <option value="30">30 min</option>
              <option value="45">45 min</option>
              <option value="60">60 min</option>
            </select>
          </div>
          <div>
            <label class="text-on-surface-variant font-label-md">Break</label>
            <select id="pomodoroBreak" class="ml-2 px-3 py-1.5 rounded-lg bg-surface-container-low text-on-surface border border-outline-variant/30 outline-none font-label-md">
              <option value="5">5 min</option>
              <option value="10">10 min</option>
              <option value="15">15 min</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Current Task Card -->
    <div class="w-full max-w-md glass-card rounded-[32px] p-gutter relative overflow-hidden group">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-2xl bg-surface-container-highest flex items-center justify-center">
            <span class="material-symbols-outlined text-primary">auto_awesome</span>
          </div>
          <div>
            <span class="font-label-caps text-label-caps text-on-surface-variant block">Current Objective</span>
            <h2 class="font-headline-lg text-headline-lg leading-tight" id="currentTaskTitle">Select a task below</h2>
          </div>
        </div>
        <div class="flex justify-between items-center">
          <div class="flex items-center gap-3 px-3 py-1 bg-outline-variant/20 rounded-full">
            <div class="w-2 h-2 rounded-full bg-error animate-pulse"></div>
            <span class="font-label-md text-label-md text-on-surface-variant" id="currentTaskPriority">—</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Session Log -->
    <div class="w-full max-w-md glass-card rounded-3xl p-6">
      <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-4 tracking-widest">SESSION LOG</h3>
      <div id="sessionLog" class="space-y-2 max-h-32 overflow-y-auto custom-scrollbar">
        <p class="text-sm text-on-surface-variant text-center py-4">No sessions logged yet. Start focusing!</p>
      </div>
    </div>
  </section>

  <!-- AI Insights Panel -->
  <aside class="w-96 p-margin-desktop flex flex-col gap-gutter border-l border-outline-variant/10 bg-surface-container-low/30 backdrop-blur-md">
    <div class="flex items-center justify-between">
      <h3 class="font-headline-lg text-headline-lg">AI Insights</h3>
      <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">spark</span>
    </div>

    <!-- Task Selector -->
    <div class="glass-card rounded-3xl p-4">
      <h4 class="font-label-caps text-label-caps text-on-surface-variant mb-3 tracking-widest">FOCUS ON</h4>
      <div class="space-y-2 max-h-48 overflow-y-auto custom-scrollbar" id="taskList">
        <% tasks.forEach(t => { %>
        <div class="p-3 rounded-xl cursor-pointer bg-surface-variant/20 hover:bg-surface-variant/40 transition-colors task-select-item" data-task-id="<%= t._id %>" data-task-title="<%= t.title %>" data-task-priority="<%= t.priority %>">
          <p class="text-sm font-medium text-on-surface"><%= t.title %></p>
          <p class="text-xs text-on-surface-variant"><%= t.category %> &middot; <%= Math.floor(t.durationLogged / 60) %>m logged</p>
        </div>
        <% }) %>
        <% if (tasks.length === 0) { %>
        <p class="text-xs text-on-surface-variant text-center py-4">No active tasks</p>
        <% } %>
      </div>
    </div>

    <!-- Insight Cards -->
    <div class="glass-card rounded-3xl p-6 ai-glow border-l-4 border-secondary transition-transform hover:translate-x-1">
      <div class="flex items-center gap-3 mb-3">
        <span class="material-symbols-outlined text-secondary">info</span>
        <span class="font-label-md text-label-md font-semibold text-secondary">Proactive Break</span>
      </div>
      <p class="font-body-sm text-on-surface-variant leading-relaxed">Your heart rate variability indicates rising cognitive load. Suggesting a <span class="text-on-surface font-medium">5-minute mindful walk</span> in 12 minutes.</p>
      <button class="mt-4 w-full py-2 rounded-xl bg-secondary/10 text-secondary font-semibold font-label-md hover:bg-secondary/20 active:scale-[0.98] transition-all">Schedule Break</button>
    </div>

    <div class="glass-card rounded-3xl p-6 border-l-4 border-primary transition-transform hover:translate-x-1">
      <div class="flex items-center gap-3 mb-3">
        <span class="material-symbols-outlined text-primary">insights</span>
        <span class="font-label-md text-label-md font-semibold text-primary">Efficiency Trend</span>
      </div>
      <p class="font-body-sm text-on-surface-variant leading-relaxed">You are finishing tasks 15% faster than last week. This focus block is your most productive yet.</p>
    </div>

    <!-- Break Options -->
    <div class="flex flex-col gap-3">
      <span class="font-label-caps text-label-caps text-on-surface-variant opacity-60 ml-2">Suggested Breaks</span>
      <div class="grid grid-cols-2 gap-3">
        <div class="glass-card p-4 rounded-2xl flex flex-col gap-2 hover:bg-surface-variant/40 cursor-pointer transition-colors">
          <span class="material-symbols-outlined text-on-surface-variant">self_improvement</span>
          <span class="font-label-md text-label-md font-medium">Meditation</span>
          <span class="font-label-caps text-[10px] text-on-surface-variant opacity-50">3 MIN</span>
        </div>
        <div class="glass-card p-4 rounded-2xl flex flex-col gap-2 hover:bg-surface-variant/40 cursor-pointer transition-colors">
          <span class="material-symbols-outlined text-on-surface-variant">water_drop</span>
          <span class="font-label-md text-label-md font-medium">Hydrate</span>
          <span class="font-label-caps text-[10px] text-on-surface-variant opacity-50">5 MIN</span>
        </div>
      </div>
    </div>

    <!-- Stats Mini -->
    <div class="mt-auto glass-card rounded-3xl p-6">
      <div class="flex justify-between items-end">
        <div>
          <span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Today's Deep Work</span>
          <span class="font-headline-lg text-headline-lg text-primary" id="todayFocusTime">0h 0m</span>
        </div>
        <div class="flex items-end gap-1 h-12">
          <div class="w-1.5 bg-outline-variant h-6 rounded-full"></div>
          <div class="w-1.5 bg-outline-variant h-8 rounded-full"></div>
          <div class="w-1.5 bg-primary h-12 rounded-full shadow-[0_0_10px_rgba(192,193,255,0.4)]"></div>
          <div class="w-1.5 bg-primary h-10 rounded-full shadow-[0_0_10px_rgba(192,193,255,0.4)]"></div>
          <div class="w-1.5 bg-outline-variant h-7 rounded-full"></div>
        </div>
      </div>
    </div>
  </aside>
</main>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/main.js"></script>
<script>
(function() {
  let timerMode = 'pomodoro';
  let isRunning = false;
  let isBreak = false;
  let timeLeft = 25 * 60;
  let totalSeconds = 25 * 60;
  let timerInterval = null;
  let selectedTaskId = null;
  let sessionLogs = [];
  let todayFocusSeconds = 0;

  const display = document.getElementById('timer-display');
  const playPauseBtn = document.getElementById('play-pause');
  const playIcon = document.getElementById('playIcon');
  const btnReset = document.getElementById('btnReset');
  const btnSkip = document.getElementById('btnSkip');
  const phaseLabel = document.getElementById('phaseLabel');
  const pomodoroConfig = document.getElementById('pomodoroConfig');
  const sessionLog = document.getElementById('sessionLog');
  const currentTaskTitle = document.getElementById('currentTaskTitle');
  const currentTaskPriority = document.getElementById('currentTaskPriority');
  const todayFocusTime = document.getElementById('todayFocusTime');

  function updateDisplay() {
    const m = Math.floor(timeLeft / 60);
    const s = timeLeft % 60;
    display.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
  }

  function selectTask(el) {
    document.querySelectorAll('.task-select-item').forEach(e => e.style.border = '1px solid transparent');
    if (el) {
      el.style.border = '1px solid rgba(192, 193, 255, 0.4)';
      selectedTaskId = el.dataset.taskId;
      currentTaskTitle.textContent = el.dataset.taskTitle;
      currentTaskPriority.textContent = el.dataset.taskPriority;
    }
  }

  document.querySelectorAll('.task-select-item').forEach(el => {
    el.addEventListener('click', () => selectTask(el));
  });

  document.querySelectorAll('.timer-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (isRunning) return;
      document.querySelectorAll('.timer-mode-btn').forEach(b => { b.classList.remove('active', 'bg-primary/20', 'text-primary'); b.classList.add('text-on-surface-variant'); });
      btn.classList.add('active', 'bg-primary/20', 'text-primary');
      btn.classList.remove('text-on-surface-variant');
      timerMode = btn.dataset.mode;
      if (timerMode === 'pomodoro') {
        pomodoroConfig.style.display = 'flex';
        const focusMin = parseInt(document.getElementById('pomodoroFocus').value);
        totalSeconds = focusMin * 60;
        if (!isRunning) { timeLeft = totalSeconds; isBreak = false; phaseLabel.textContent = 'Deep Focus Phase'; updateDisplay(); }
      } else {
        pomodoroConfig.style.display = 'none';
        if (!isRunning) { timeLeft = 0; totalSeconds = 0; phaseLabel.textContent = 'Stopwatch'; updateDisplay(); }
      }
    });
  });

  document.getElementById('pomodoroFocus').addEventListener('change', () => {
    if (timerMode === 'pomodoro' && !isRunning) {
      totalSeconds = parseInt(document.getElementById('pomodoroFocus').value) * 60;
      timeLeft = totalSeconds;
      updateDisplay();
    }
  });

  function logSession(minutes) {
    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const label = isBreak ? 'Break' : 'Focus';
    sessionLogs.push({ time: timeStr, label, minutes, taskId: selectedTaskId });

    if (!isBreak) {
      todayFocusSeconds += minutes * 60;
      const h = Math.floor(todayFocusSeconds / 3600);
      const m = Math.floor((todayFocusSeconds % 3600) / 60);
      todayFocusTime.textContent = h + 'h ' + m + 'm';
    }

    const logHtml = sessionLogs.slice().reverse().map(e =>
      '<div class="flex items-center justify-between text-sm py-1 border-b border-outline-variant/10 last:border-0">' +
        '<span class="' + (e.label === 'Focus' ? 'text-primary' : 'text-secondary') + ' font-medium">' + e.label + '</span>' +
        '<span class="text-on-surface-variant">' + e.time + '</span>' +
        '<span class="text-on-surface">' + e.minutes + 'm</span>' +
      '</div>'
    ).join('');
    sessionLog.innerHTML = logHtml;

    if (selectedTaskId && !isBreak) {
      fetch('/api/tasks/' + selectedTaskId + '/log-time', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ secondsLogged: minutes * 60 })
      });
    }
  }

  function timerComplete() {
    isRunning = false;
    clearInterval(timerInterval);
    if (timerMode === 'pomodoro') {
      const focusMin = parseInt(document.getElementById('pomodoroFocus').value);
      logSession(isBreak ? parseInt(document.getElementById('pomodoroBreak').value) : focusMin);
      if (!isBreak) {
        isBreak = true;
        const breakMin = parseInt(document.getElementById('pomodoroBreak').value);
        totalSeconds = breakMin * 60;
        timeLeft = totalSeconds;
        phaseLabel.textContent = 'Break Time';
        updateDisplay();
      } else {
        isBreak = false;
        totalSeconds = parseInt(document.getElementById('pomodoroFocus').value) * 60;
        timeLeft = totalSeconds;
        phaseLabel.textContent = 'Deep Focus Phase';
        updateDisplay();
      }
    }
    playIcon.textContent = 'play_arrow';
    playPauseBtn.classList.remove('animate-pulse');
  }

  playPauseBtn.addEventListener('click', () => {
    if (isRunning) {
      isRunning = false;
      clearInterval(timerInterval);
      playIcon.textContent = 'play_arrow';
      playPauseBtn.classList.remove('animate-pulse');
    } else {
      isRunning = true;
      playIcon.textContent = 'pause';
      playPauseBtn.classList.add('animate-pulse');
      if (timerMode === 'stopwatch' && timeLeft === 0) totalSeconds = 0;
      timerInterval = setInterval(() => {
        if (timerMode === 'stopwatch') { timeLeft++; totalSeconds = timeLeft; }
        else { timeLeft--; }
        updateDisplay();
        if (timerMode === 'pomodoro' && timeLeft <= 0) { clearInterval(timerInterval); timerComplete(); }
      }, 1000);
    }
  });

  btnReset.addEventListener('click', () => {
    isRunning = false;
    clearInterval(timerInterval);
    playIcon.textContent = 'play_arrow';
    playPauseBtn.classList.remove('animate-pulse');
    if (timerMode === 'pomodoro') {
      isBreak = false;
      totalSeconds = parseInt(document.getElementById('pomodoroFocus').value) * 60;
      timeLeft = totalSeconds;
      phaseLabel.textContent = 'Deep Focus Phase';
    } else {
      if (totalSeconds > 0) logSession(Math.floor(totalSeconds / 60));
      totalSeconds = 0; timeLeft = 0;
      phaseLabel.textContent = 'Stopwatch';
    }
    updateDisplay();
  });

  btnSkip.addEventListener('click', () => {
    if (timerMode === 'pomodoro' && isRunning) {
      clearInterval(timerInterval);
      timerComplete();
    }
  });

  updateDisplay();
})();
</script>
<style>
.timer-glow { text-shadow: 0 0 40px rgba(192, 193, 255, 0.3); }
@keyframes pulse-slow { 0%, 100% { opacity: 0.3; transform: scale(1); } 50% { opacity: 0.6; transform: scale(1.05); } }
.animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }
.custom-scrollbar::-webkit-scrollbar { width: 4px; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #464554; border-radius: 10px; }
</style>
</body>
</html>
