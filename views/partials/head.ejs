<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lumina AI | <%= typeof title !== 'undefined' ? title : 'Intelligent Focus Suite' %></title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Inter:wght@400;500&family=Geist:wght@500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link href="/css/lumina.css" rel="stylesheet">
  <style>
    body {
      background-color: #031427;
      scrollbar-width: thin;
      scrollbar-color: #464554 #031427;
    }
    .glass-card {
      background: rgba(16, 32, 52, 0.4);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card:hover {
      border-color: #c0c1ff;
      transform: translateY(-4px);
      box-shadow: 0px 10px 30px rgba(99, 102, 241, 0.15);
    }
    .ai-glow {
      box-shadow: 0 0 20px rgba(221, 183, 255, 0.1);
      border-left: 3px solid #ddb7ff;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .progress-ring-circle {
      transition: stroke-dashoffset 0.8s ease-in-out;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #031427; }
    ::-webkit-scrollbar-thumb { background: #26364a; border-radius: 10px; }
    @keyframes pulse-slow {
      0%, 100% { opacity: 0.3; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.05); }
    }
    .animate-pulse-slow {
      animation: pulse-slow 8s ease-in-out infinite;
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up {
      animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .ai-gradient-text {
      background: linear-gradient(135deg, #c0c1ff 0%, #ddb7ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-dim": "#031427",
            "inverse-on-surface": "#213145",
            "secondary-fixed-dim": "#ddb7ff",
            "on-tertiary-fixed": "#111c2d",
            "surface-container-high": "#1b2b3f",
            "outline": "#908fa0",
            "surface-variant": "#26364a",
            "tertiary": "#bcc7de",
            "on-tertiary": "#263143",
            "primary": "#c0c1ff",
            "error-container": "#93000a",
            "surface-container-lowest": "#000f21",
            "background": "#031427",
            "surface-container-highest": "#26364a",
            "surface-tint": "#c0c1ff",
            "on-error-container": "#ffdad6",
            "secondary": "#ddb7ff",
            "error": "#ffb4ab",
            "outline-variant": "#464554",
            "on-primary-fixed": "#07006c",
            "surface-container": "#102034",
            "surface": "#031427",
            "surface-container-low": "#0b1c30",
            "inverse-primary": "#494bd6",
            "on-primary-container": "#0d0096",
            "tertiary-fixed": "#d8e3fb",
            "on-secondary-container": "#d6a9ff",
            "on-secondary": "#490080",
            "inverse-surface": "#d3e4fe",
            "surface-bright": "#2a3a4f",
            "tertiary-container": "#8691a7",
            "on-surface-variant": "#c7c4d7",
            "on-tertiary-fixed-variant": "#3c475a",
            "secondary-container": "#6f00be",
            "secondary-fixed": "#f0dbff",
            "on-error": "#690005",
            "on-secondary-fixed-variant": "#6900b3",
            "primary-fixed": "#e1e0ff",
            "on-primary": "#1000a9",
            "primary-container": "#8083ff",
            "on-secondary-fixed": "#2c0051",
            "on-background": "#d3e4fe",
            "on-primary-fixed-variant": "#2f2ebe",
            "primary-fixed-dim": "#c0c1ff",
            "tertiary-fixed-dim": "#bcc7de",
            "on-surface": "#d3e4fe",
            "on-tertiary-container": "#1f2a3c"
          },
          borderRadius: {
            DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", "full": "9999px"
          },
          spacing: {
            "margin-mobile": "16px", "margin-desktop": "40px", "container-max": "1200px", "base": "8px", "gutter": "24px"
          },
          fontFamily: {
            "headline-lg": ["Hanken Grotesk"],
            "body-sm": ["Inter"], "body-md": ["Inter"],
            "headline-lg-mobile": ["Hanken Grotesk"],
            "display-lg": ["Hanken Grotesk"],
            "label-md": ["Geist"], "label-caps": ["Geist"]
          },
          fontSize: {
            "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
            "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
            "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
            "headline-lg-mobile": ["28px", {"lineHeight": "36px", "fontWeight": "600"}],
            "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
            "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}],
            "label-caps": ["10px", {"lineHeight": "12px", "letterSpacing": "0.1em", "fontWeight": "600"}]
          }
        }
      }
    }
  </script>
</head>
<body class="bg-surface-dim text-on-surface font-body-md overflow-x-hidden">
