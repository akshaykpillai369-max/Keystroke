<%- include('partials/head', { title: 'Daily Overview' }) %>
<%- include('partials/sidebar') %>

<!-- Top Nav Bar -->
<header class="fixed top-0 right-0 w-[calc(100%-16rem)] flex justify-between items-center px-margin-desktop py-4 z-40 backdrop-blur-xl bg-surface-dim/30">
  <div class="flex items-center flex-1 max-w-xl">
    <div class="relative w-full">
      <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
      <input class="w-full bg-surface-container-low border-none rounded-full py-2.5 pl-12 pr-4 text-body-md focus:ring-2 focus:ring-primary/30 transition-all placeholder:text-on-surface-variant/50" placeholder="Search tasks, insights, or files..." type="text" />
    </div>
  </div>
  <div class="flex items-center gap-6">
    <div class="flex items-center gap-4">
      <button class="text-on-surface-variant hover:text-primary transition-colors" onclick="alert('No new notifications')" title="Notifications"><span class="material-symbols-outlined">notifications</span></button>
      <button class="text-on-surface-variant hover:text-primary transition-colors" onclick="alert('Feature coming soon: AI Spark')" title="AI Spark"><span class="material-symbols-outlined">spark</span></button>
    </div>
    <button class="bg-secondary-container text-on-secondary-container px-5 py-2 rounded-full font-semibold flex items-center gap-2 hover:opacity-90 active:scale-95 transition-all" onclick="toggleDrawer()">
      <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
      AI Assistant
    </button>
    <div class="w-10 h-10 rounded-full bg-secondary-container border-2 border-outline-variant/30 flex items-center justify-center text-on-secondary-container font-semibold text-sm">A</div>
  </div>
</header>

<!-- Main Content -->
<main class="ml-64 pt-24 pb-12 px-margin-desktop">
  <div class="max-w-container-max mx-auto">
    <!-- Hero Header -->
    <div class="flex justify-between items-end mb-10">
      <div>
        <h2 class="font-headline-lg text-display-lg text-on-surface tracking-tight">Welcome back.</h2>
        <p class="text-on-surface-variant mt-2 max-w-lg">Your focus score is looking strong today. Let's tackle the high-impact items first.</p>
      </div>
      <div class="flex items-center gap-8 bg-surface-container-high/40 p-6 rounded-3xl glass-card">
        <div class="relative w-24 h-24">
          <svg class="w-24 h-24" viewBox="0 0 100 100">
            <circle class="text-surface-variant" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-width="8"></circle>
            <circle class="text-primary progress-ring-circle" cx="50" cy="50" fill="transparent" r="40" stroke="currentColor" stroke-dasharray="251.2" stroke-dashoffset="<%= 251.2 * (1 - stats.completedTasks / Math.max(stats.totalTasks, 1)) %>" stroke-linecap="round" stroke-width="8"></circle>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="font-headline-lg text-headline-lg text-primary"><%= stats.completionRate %>%</span>
          </div>
        </div>
        <div>
          <p class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Daily Progress</p>
          <p class="font-headline-lg text-headline-lg text-on-surface"><%= stats.completedTasks %> of <%= stats.totalTasks %> Tasks</p>
          <p class="font-label-md text-label-md text-primary mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">trending_up</span>
            <%= stats.totalFocusTime > 0 ? Math.floor(stats.totalFocusTime / 60) + 'm focus logged' : 'Start focusing!' %>
          </p>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <div class="glass-card p-6 rounded-2xl">
        <div class="flex justify-between items-start mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">timer</span>
          </div>
        </div>
        <p class="text-3xl font-bold text-on-surface"><%= Math.floor(stats.totalFocusTime / 3600) %>h <%= Math.floor((stats.totalFocusTime % 3600) / 60) %>m</p>
        <p class="text-on-surface-variant font-label-md mt-1">Total Focus Time</p>
      </div>
      <div class="glass-card p-6 rounded-2xl">
        <div class="flex justify-between items-start mb-4">
          <div class="w-10 h-10 bg-secondary/10 rounded-xl flex items-center justify-center text-secondary">
            <span class="material-symbols-outlined">speed</span>
          </div>
        </div>
        <p class="text-3xl font-bold text-on-surface"><%= stats.completionRate %>%</p>
        <p class="text-on-surface-variant font-label-md mt-1">Task Velocity</p>
      </div>
      <div class="glass-card p-6 rounded-2xl">
        <div class="flex justify-between items-start mb-4">
          <div class="w-10 h-10 bg-tertiary/10 rounded-xl flex items-center justify-center text-tertiary">
            <span class="material-symbols-outlined">pending_actions</span>
          </div>
        </div>
        <p class="text-3xl font-bold text-on-surface"><%= stats.inProgressTasks %></p>
        <p class="text-on-surface-variant font-label-md mt-1">In Progress</p>
      </div>
      <div class="glass-card p-6 rounded-2xl">
        <div class="flex justify-between items-start mb-4">
          <div class="w-10 h-10 bg-error/10 rounded-xl flex items-center justify-center text-error">
            <span class="material-symbols-outlined">list_alt</span>
          </div>
        </div>
        <p class="text-3xl font-bold text-on-surface"><%= stats.todoTasks %></p>
        <p class="text-on-surface-variant font-label-md mt-1">Remaining</p>
      </div>
    </div>

    <!-- AI Priority Section -->
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
        <h3 class="font-headline-lg text-headline-lg">AI Priority</h3>
        <span class="px-2 py-0.5 bg-secondary-container/30 text-secondary rounded font-label-caps text-label-caps ml-2">URGENT & HIGH ENERGY</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% const priorityTasks = [...columns.todo, ...columns.inProgress].slice(0, 3); %>
        <% priorityTasks.forEach((t, i) => { %>
        <div class="glass-card ai-glow p-6 rounded-2xl relative overflow-hidden group">
          <div class="absolute top-0 right-0 p-3 opacity-20 group-hover:opacity-40 transition-opacity">
            <span class="material-symbols-outlined text-[64px] text-secondary"><%= i === 0 ? 'bolt' : i === 1 ? 'auto_graph' : 'psychology' %></span>
          </div>
          <div class="flex justify-between items-start mb-4">
            <span class="px-3 py-1 bg-surface-container-highest rounded-full font-label-caps text-label-caps text-secondary border border-secondary/20"><%= t.priority === 'Urgent' ? 'CRITICAL' : 'HIGH ENERGY' %></span>
            <span class="text-on-surface-variant font-label-md text-label-md flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">schedule</span>
              <%= Math.floor(t.durationLogged / 60) || '—' %>m
            </span>
          </div>
          <h4 class="font-headline-lg text-headline-lg mb-2 group-hover:text-primary transition-colors"><%= t.title %></h4>
          <p class="text-on-surface-variant text-body-sm line-clamp-2"><%= t.description || 'No description' %></p>
          <div class="mt-6 flex items-center justify-between">
            <span class="font-label-caps text-label-caps text-on-surface-variant bg-surface-variant px-2 py-1 rounded"><%= t.category %></span>
            <button class="p-2 rounded-full hover:bg-white/10 transition-colors" onclick="updateTaskStatus('<%= t._id %>', 'In Progress')">
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        </div>
        <% }) %>
        <% if (priorityTasks.length === 0) { %>
        <div class="glass-card p-6 rounded-2xl col-span-3 text-center">
          <p class="text-on-surface-variant">No tasks yet. Create one to get started!</p>
        </div>
        <% } %>
      </div>
    </section>

    <!-- Bottom Layout: Tasks & Suggestion -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <!-- Daily Task List -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex justify-between items-center mb-6">
          <h3 class="font-headline-lg text-headline-lg">Daily Tasks</h3>
          <div class="flex gap-2">
            <button class="text-on-surface-variant hover:text-on-surface p-2 rounded-lg bg-surface-container-low active:scale-[0.98] transition-all" onclick="filterTasks()" title="Filter tasks"><span class="material-symbols-outlined">filter_list</span></button>
            <button class="text-on-surface-variant hover:text-on-surface p-2 rounded-lg bg-surface-container-low active:scale-[0.98] transition-all" onclick="sortTasks()" title="Sort tasks"><span class="material-symbols-outlined">sort</span></button>
          </div>
        </div>
        <div class="space-y-3">
          <% columns.todo.concat(columns.inProgress).forEach(t => { %>
          <div class="glass-card p-4 rounded-xl flex items-center gap-4 group">
            <button class="w-6 h-6 rounded-full border-2 border-outline-variant flex items-center justify-center group-hover:border-primary transition-colors" onclick="updateTaskStatus('<%= t._id %>', 'Completed')">
              <span class="material-symbols-outlined text-[16px] text-primary opacity-0 group-hover:opacity-100">check</span>
            </button>
            <div class="flex-1">
              <h5 class="text-body-md font-medium"><%= t.title %></h5>
              <% if (t.description) { %><p class="text-label-md text-on-surface-variant"><%= t.description %></p><% } %>
            </div>
            <span class="text-label-caps text-on-surface-variant bg-surface-variant px-2 py-1 rounded"><%= t.priority %></span>
          </div>
          <% }) %>
          <% columns.completed.forEach(t => { %>
          <div class="glass-card p-4 rounded-xl flex items-center gap-4 group opacity-50">
            <button class="w-6 h-6 rounded-full bg-primary border-2 border-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-[16px] text-on-primary">check</span>
            </button>
            <div class="flex-1">
              <h5 class="text-body-md font-medium line-through"><%= t.title %></h5>
            </div>
            <span class="material-symbols-outlined text-primary">verified</span>
          </div>
          <% }) %>
          <% if (stats.totalTasks === 0) { %>
          <p class="text-on-surface-variant text-center py-8">No tasks yet. Click "New Task" to begin.</p>
          <% } %>
        </div>
      </div>

      <!-- Sidebar Insights -->
      <div class="space-y-6">
        <!-- Smart Suggestion Card -->
        <div class="bg-primary-container/20 border border-primary/20 p-6 rounded-3xl relative overflow-hidden">
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-4 text-primary">
              <span class="material-symbols-outlined">lightbulb</span>
              <h4 class="font-label-caps text-label-caps uppercase tracking-widest">Smart Suggestion</h4>
            </div>
            <p class="text-body-md text-on-surface mb-6">You have <%= stats.todoTasks %> tasks remaining. Focus on high-priority items first thing tomorrow.</p>
            <div class="flex gap-3">
              <button class="flex-1 bg-primary text-on-primary py-2.5 rounded-xl font-semibold hover:opacity-90 active:scale-[0.98] transition-all" onclick="window.location.href='/timer'">Focus Now</button>
            </div>
          </div>
          <div class="absolute -bottom-6 -right-6 opacity-10">
            <span class="material-symbols-outlined text-[120px] text-primary">calendar_clock</span>
          </div>
        </div>

        <!-- AI Insights Panel -->
        <% if (insights.length > 0) { %>
        <div class="glass-card rounded-3xl p-6 ai-glow">
          <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">spark</span>
            <h4 class="font-headline-lg text-lg text-on-surface">AI Insights</h4>
          </div>
          <div class="space-y-4" id="insights-container">
            <% insights.forEach(i => { %>
            <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-variant/20">
              <span class="material-symbols-outlined text-secondary text-sm">info</span>
              <p class="text-body-sm text-on-surface-variant"><%= i.message %></p>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Deep Focus Mode Card -->
        <div class="glass-card rounded-3xl overflow-hidden aspect-[4/5] relative">
          <div class="absolute inset-0 bg-gradient-to-br from-surface-container-high via-surface-dim to-surface-dim"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-surface-dim via-transparent to-transparent"></div>
          <div class="absolute bottom-0 p-6">
            <h4 class="font-headline-lg text-headline-lg text-white mb-2">Deep Focus Mode</h4>
            <p class="text-body-sm text-on-surface-variant mb-4">Minimize distractions and activate AI flow state tracking.</p>
            <button class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-6 py-2.5 rounded-full font-semibold hover:bg-white/20 active:scale-[0.98] transition-all flex items-center gap-2" onclick="window.location.href='/timer'">
              <span class="material-symbols-outlined">graphic_eq</span>
              Enter Flow
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- AI Drawer -->
<div class="fixed right-0 top-0 h-screen w-80 bg-surface-container-low/90 backdrop-blur-2xl border-l border-outline-variant/20 shadow-2xl shadow-primary/10 flex flex-col p-gutter z-50 translate-x-full transition-transform duration-500 ease-in-out" id="ai-drawer">
  <div class="flex items-center gap-4 mb-8">
    <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container">
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
    </div>
    <div>
      <h3 class="font-headline-lg text-headline-lg text-secondary">AI Assistant</h3>
      <p class="font-body-sm text-body-sm text-on-surface-variant">How can I help you focus?</p>
    </div>
  </div>
  <nav class="space-y-2 mb-8">
    <button class="w-full flex items-center gap-3 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-xl" onclick="alert('Feature coming soon: Task Breakdown')">
      <span class="material-symbols-outlined">account_tree</span>
      <span class="font-label-caps text-label-caps">Task Breakdown</span>
    </button>
    <button class="w-full flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant/30 rounded-xl transition-all" onclick="alert('Feature coming soon: Suggested Times')">
      <span class="material-symbols-outlined">schedule</span>
      <span class="font-label-caps text-label-caps">Suggested Times</span>
    </button>
    <button class="w-full flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant/30 rounded-xl transition-all" onclick="alert('Feature coming soon: Resource Links')">
      <span class="material-symbols-outlined">link</span>
      <span class="font-label-caps text-label-caps">Resource Links</span>
    </button>
    <button class="w-full flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant/30 rounded-xl transition-all" onclick="alert('Feature coming soon: AI Insights')">
      <span class="material-symbols-outlined">insights</span>
      <span class="font-label-caps text-label-caps">AI Insights</span>
    </button>
  </nav>
  <div class="mt-auto bg-surface-variant/20 rounded-2xl p-4 border border-outline-variant/10">
    <p class="text-label-md text-on-surface-variant mb-4">Analyzing your work patterns...</p>
    <div class="h-1 w-full bg-surface-container-highest rounded-full overflow-hidden">
      <div class="h-full bg-secondary w-2/3 animate-pulse"></div>
    </div>
  </div>
</div>

<!-- FAB -->
<button class="fixed bottom-8 right-8 w-16 h-16 bg-gradient-to-br from-primary to-secondary rounded-full shadow-lg shadow-primary/30 flex items-center justify-center text-on-primary hover:scale-110 active:scale-95 transition-all z-40" onclick="toggleDrawer()">
  <span class="material-symbols-outlined text-3xl">smart_toy</span>
</button>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/main.js"></script>
<script>
function toggleDrawer() { document.getElementById('ai-drawer').classList.toggle('translate-x-full'); }
function updateTaskStatus(id, status) {
  fetch('/api/tasks/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) })
    .then(() => window.location.reload());
}
function filterTasks() {
  const tasks = document.querySelectorAll('.glass-card.p-4.rounded-xl');
  // Toggle showing only high priority tasks
  tasks.forEach(el => {
    const badge = el.querySelector('.text-label-caps');
    if (badge) {
      const isUrgent = badge.textContent.trim() === 'Urgent';
      el.style.opacity = isUrgent ? '1' : '0.3';
    }
  });
  setTimeout(() => tasks.forEach(el => el.style.opacity = '1'), 2000);
}
function sortTasks() {
  alert('Tasks re-sorted by priority.');
}
// Intersection observer for fade-in
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => { if (entry.isIntersecting) { entry.target.style.opacity = '1'; entry.target.style.transform = 'translateY(0)'; } });
}, { threshold: 0.1 });
document.querySelectorAll('.glass-card').forEach(card => {
  card.style.opacity = '0';
  card.style.transform = 'translateY(20px)';
  card.style.transition = 'all 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
  observer.observe(card);
});
</script>
</body>
</html>
